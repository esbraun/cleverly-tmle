__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
target/
# Benchmark *runs* are machine-specific and are not committed; the written-up
# findings that live beside them are. A `results.jsonl` from a four-core sandbox
# would read as a fact about the package rather than about that box.
benchmarks/results/*
!benchmarks/results/*.md
!benchmarks/results/.gitkeep
