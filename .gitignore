__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.nox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
target/
# Benchmark *runs* are machine-specific and are not committed: a `results.jsonl`
# from a four-core sandbox would read as a fact about the package rather than
# about that box. This directory is now output only -- the write-ups that used to
# sit beside it live in `docs/benchmarks/`, where a reader looking for the
# findings will find them and a `--output` will not overwrite them.
benchmarks/results/*
!benchmarks/results/.gitkeep
